# Local demo only. Run a single worker bound to 127.0.0.1.
AUTH_MODE=demo
DEMO_TOKEN=local-demo-change-me
SQLITE_PATH=airport.sqlite3
CORS_ORIGINS=["http://localhost:5173"]
SCENARIO_DIR=fixtures
# For Supabase: AUTH_MODE=supabase; choose direct Postgres or the HTTPS adapter below.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
DATABASE_URL=
PERSISTENCE_MODE=postgres
# For networks blocking Postgres: PERSISTENCE_MODE=supabase_http and a backend-only key.
SUPABASE_SECRET_KEY=
# Supabase direct/session-pooler connection; never expose to the frontend.
# No LLM key is needed by Member 1. Inject Member 3's coordinator for LIVE mode.
ANTHROPIC_API_KEY=